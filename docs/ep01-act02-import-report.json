  "cgCues": [
    {
      "sceneId": "EP01_ACT02_SC01",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG01-01｜依原稿插入位置配對正文",
      "paragraph": "清晨的研究室，比平常更早亮起了燈。"
    },
    {
      "sceneId": "EP01_ACT02_SC01",
      "beforeSegment": 4,
      "cue": "CG",
      "text": "EP01-ACT02-CG01-02｜依原稿插入位置配對正文",
      "paragraph": "房門被推開，一個帶著外勤行囊與調查資料匣的人站在門口，先是看了看房內，接著又看了看門牌，像是在確認自己是不是走錯了地方。"
    },
    {
      "sceneId": "EP01_ACT02_SC01",
      "beforeSegment": 13,
      "cue": "CG",
      "text": "EP01-ACT02-CG01-03｜依原稿插入位置配對正文",
      "paragraph": "奧莉維亞把那封已拆開的信遞了過去。"
    },
    {
      "sceneId": "EP01_ACT02_SC01",
      "beforeSegment": 35,
      "cue": "CG",
      "text": "EP01-ACT02-CG01-04｜依原稿插入位置配對正文",
      "paragraph": "芬利把外地帶回來的資料袋打開，抽出捆好的記錄與測試圖板，坐到了桌邊。"
    },
    {
      "sceneId": "EP01_ACT02_SC02",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG02-01｜依原稿插入位置配對正文",
      "paragraph": "研究一旦被攤開，就不會允許情緒把所有問題暫時帶過。"
    },
    {
      "sceneId": "EP01_ACT02_SC02",
      "beforeSegment": 2,
      "cue": "CG",
      "text": "EP01-ACT02-CG02-02｜依原稿插入位置配對正文",
      "paragraph": "芬利把這次出差帶回來的資料一份份拆開。"
    },
    {
      "sceneId": "EP01_ACT02_SC02",
      "beforeSegment": 14,
      "cue": "CG",
      "text": "EP01-ACT02-CG02-03｜依原稿插入位置配對正文",
      "paragraph": "很快，新的問題浮了出來：哪些工作可以留在學院，哪些卻必須有人帶去王都處理？"
    },
    {
      "sceneId": "EP01_ACT02_SC02",
      "beforeSegment": 26,
      "cue": "CG",
      "text": "EP01-ACT02-CG02-04｜依原稿插入位置配對正文",
      "paragraph": "「我可以接這一段。」"
    },
    {
      "sceneId": "EP01_ACT02_SC03",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG03-01｜依原稿插入位置配對正文",
      "paragraph": "研究不可能在一個上午內就被重新安排完。"
    },
    {
      "sceneId": "EP01_ACT02_SC03",
      "beforeSegment": 4,
      "cue": "CG",
      "text": "EP01-ACT02-CG03-02｜依原稿插入位置配對正文",
      "paragraph": "「如果妳回去之後，第一件事就被別人決定了，後面的安排會全部被拖著走。」芬利說。"
    },
    {
      "sceneId": "EP01_ACT02_SC03",
      "beforeSegment": 14,
      "cue": "CG",
      "text": "EP01-ACT02-CG03-03｜依原稿插入位置配對正文",
      "paragraph": "奧莉維亞看著眼前的三個方向，手指在桌面上輕敲了兩下。"
    },
    {
      "sceneId": "EP01_ACT02_SC03_COMMON",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG03-04｜選擇確立後的共同工作計畫",
      "paragraph": "不論奧莉維亞選擇哪一條路，最終都會回到同一個現實：他們不是去王都觀光，而是去工作。"
    },
    {
      "sceneId": "EP01_ACT02_SC04",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG04-01｜依原稿插入位置配對正文",
      "paragraph": "午後的行政會談室比研究室安靜得多。"
    },
    {
      "sceneId": "EP01_ACT02_SC04",
      "beforeSegment": 8,
      "cue": "CG",
      "text": "EP01-ACT02-CG04-02｜依原稿插入位置配對正文",
      "paragraph": "法伊德沒有立刻反對。他翻看了幾頁初步整理好的資料清單，問的也不是「為什麼要讓芬利去」，而是更實際的問題。"
    },
    {
      "sceneId": "EP01_ACT02_SC04",
      "beforeSegment": 12,
      "cue": "CG",
      "text": "EP01-ACT02-CG04-03｜依原稿插入位置配對正文",
      "paragraph": "法伊德又問：「帶去王都的資料有哪些？回報頻率如何？留在學院的人手由誰主責？」"
    },
    {
      "sceneId": "EP01_ACT02_SC04",
      "beforeSegment": 22,
      "cue": "CG",
      "text": "EP01-ACT02-CG04-04｜依原稿插入位置配對正文",
      "paragraph": "芬利接過那份核准文件時，沒有表現得太輕鬆。"
    },
    {
      "sceneId": "EP01_ACT02_SC05",
      "beforeSegment": 0,
      "cue": "CG",
      "text": "EP01-ACT02-CG05-01｜依原稿插入位置配對正文",
      "paragraph": "傍晚時，研究室終於有了要暫時封存的模樣。"
    },
    {
      "sceneId": "EP01_ACT02_SC05",
      "beforeSegment": 11,
      "cue": "CG",
      "text": "EP01-ACT02-CG05-02｜依原稿插入位置配對正文",
      "paragraph": "從研究室離開時，兩人都停了一下。"
    },
    {
      "sceneId": "EP01_ACT02_SC05",
      "beforeSegment": 13,
      "cue": "CG",
      "text": "EP01-ACT02-CG05-03｜依原稿插入位置配對正文",
      "paragraph": "次日一早，學院大門外已備好返都馬車。"
    },
    {
      "sceneId": "EP01_ACT02_SC05",
      "beforeSegment": 27,
      "cue": "CG",
      "text": "EP01-ACT02-CG05-04｜依原稿插入位置配對正文",
      "paragraph": "片刻後，車輪開始轉動。"
    }
  ],
  "notes": [
    "正文原樣保留；原稿分支僅播放所選的一段，再匯流",
    "CG插入清單未含行內標記，依列出的事件配對正文錨點，報告保留對照",
    "原稿未定義政治點數／動盪數值效果：保持既有資源，只記錄優先順序旗標",
    "芬利本幕以研究夥伴登場不解鎖EP04正式支線事件、不加CLEAR、不提早揭露秘密",
    "僅幕末待續，不結算整章；ACT III未提供；無新增音訊"
  ]
}
