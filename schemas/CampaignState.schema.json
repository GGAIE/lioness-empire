{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "planVersion": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "SANDBOX",
        "PLAYER"
      ]
    },
    "chapter": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(PROLOGUE|EP(0[1-9]|1[0-2]))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "act": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "completedChapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(PROLOGUE|EP(0[1-9]|1[0-2]))$"
      }
    },
    "politicalPoints": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "unrest": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "politicalRoute": {
      "type": "string",
      "enum": [
        "NONE",
        "SACRED",
        "WORLD"
      ]
    },
    "tarotRoute": {
      "type": "string",
      "enum": [
        "NONE",
        "STAR",
        "CHARIOT",
        "TOWER"
      ]
    },
    "clear": {
      "type": "object",
      "properties": {
        "alinda": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "finley": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "tamara": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "shalia": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "alinda",
        "finley",
        "tamara",
        "shalia"
      ],
      "additionalProperties": false
    },
    "cooperation": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "UNKNOWN",
          "ACTIVE",
          "LOST"
        ]
      }
    },
    "upkeep": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter": {
            "type": "string",
            "pattern": "^(PROLOGUE|EP(0[1-9]|1[0-2]))$"
          },
          "unrest": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "chapter",
          "unrest",
          "cost"
        ],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "storyChoices": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eventParts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "enum": [
          "SUCCEEDED",
          "FAILED"
        ]
      }
    },
    "nielsFailed": {
      "type": "boolean"
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      }
    },
    "sealed": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "planVersion",
    "mode",
    "chapter",
    "act",
    "completedChapters",
    "politicalPoints",
    "unrest",
    "politicalRoute",
    "tarotRoute",
    "clear",
    "cooperation",
    "upkeep",
    "decisions",
    "storyChoices",
    "milestones",
    "eventParts",
    "nielsFailed",
    "facts",
    "sealed"
  ],
  "additionalProperties": false,
  "title": "CampaignState"
}
